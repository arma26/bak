#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
bak - versioned backups for files and directories

Usage:
  bak [--root PATH] [--exclude GLOB ...] [--list] [--version ID] [--revert] [--diff] [--dry-run|--apply] <path>
  bak --diff [--version ID] [--root PATH] <path> [path ...]
  bak --list [--root PATH]

Defaults:
  Backup runs apply by default; revert runs dry-run by default.

Examples:
  bak ~/.config/app.conf
  bak --apply ~/.config/app.conf
  bak --list ~/.config/app.conf
  bak --list
  bak --revert --apply ~/.config/app.conf
  bak --revert --version 20260224T120501Z --apply ~/.config/app.conf
  bak --apply --exclude "*.bin" --exclude "*.png" ~/data
  bak --diff ~/.config/app.conf
  bak --diff --version 20260224T120501Z ~/.config/app.conf
  bak --diff ~/.config/app.conf ~/.config/other.conf
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

log() {
  printf '%s\n' "$*"
}

expand_user_path() {
  case "$1" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${1#~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

abs_path_maybe_missing() {
  target="$1"
  if [ -e "$target" ]; then
    if [ -d "$target" ]; then
      (cd "$target" && pwd -P) || return 1
    else
      dir="$(dirname -- "$target")"
      base="$(basename -- "$target")"
      (cd "$dir" && printf '%s/%s\n' "$(pwd -P)" "$base") || return 1
    fi
  else
    dir="$(dirname -- "$target")"
    base="$(basename -- "$target")"
    (cd "$dir" && printf '%s/%s\n' "$(pwd -P)" "$base") || return 1
  fi
}

base64url() {
  if command -v openssl >/dev/null 2>&1; then
    printf '%s' "$1" | openssl base64 -A | tr '+/' '-_' | tr -d '='
    return
  fi
  if command -v base64 >/dev/null 2>&1; then
    printf '%s' "$1" | base64 | tr -d '\n' | tr '+/' '-_' | tr -d '='
    return
  fi
  return 1
}

make_key() {
  parent="$1"
  base="$2"
  parent_b64="$(base64url "$parent")" || return 1
  printf '%s_%s\n' "$parent_b64" "$base"
}

pick_hash_tool() {
  if command -v shasum >/dev/null 2>&1; then
    echo "shasum"
    return
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    echo "sha256sum"
    return
  fi
  return 1
}

pick_diff_tool() {
  if diff --help 2>&1 | grep -q -- '--color'; then
    echo "diff --color=always"
    return
  fi
  if command -v colordiff >/dev/null 2>&1; then
    echo "colordiff"
    return
  fi
  echo "diff"
}

run_diff() {
  left="$1"
  right="$2"
  tool="$(pick_diff_tool)"
  if [ "$tool" = "diff --color=always" ]; then
    diff --color=always -u "$left" "$right"
  elif [ "$tool" = "colordiff" ]; then
    colordiff -u "$left" "$right"
  else
    diff -u "$left" "$right"
  fi
}

run_diff_dir() {
  left="$1"
  right="$2"
  tool="$(pick_diff_tool)"
  if [ "$tool" = "diff --color=always" ]; then
    diff --color=always -ru "$left" "$right"
  elif [ "$tool" = "colordiff" ]; then
    colordiff -ru "$left" "$right"
  else
    diff -ru "$left" "$right"
  fi
}

hash_file() {
  tool="$1"
  file="$2"
  if [ "$tool" = "shasum" ]; then
    shasum -a 256 "$file" | awk '{print $1}'
  else
    sha256sum "$file" | awk '{print $1}'
  fi
}

matches_exclude() {
  candidate="$1"
  for pat in $EXCLUDE_PATTERNS; do
    case "$candidate" in
      $pat) return 0 ;;
    esac
  done
  return 1
}

ensure_dir() {
  if [ "$DRY_RUN" -eq 1 ]; then
    log "dry-run: mkdir -p $1"
  else
    mkdir -p "$1"
  fi
}

run_tar_create() {
  archive="$1"
  src_parent="$2"
  src_base="$3"

  set -- tar -cpf "$archive"
  for pat in $EXCLUDE_PATTERNS; do
    set -- "$@" --exclude "$pat"
  done
  set -- "$@" -C "$src_parent" "$src_base"

  if [ "$DRY_RUN" -eq 1 ]; then
    log "dry-run: $*"
  else
    "$@"
  fi
}

run_tar_extract() {
  archive="$1"
  dest_parent="$2"

  if [ "$DRY_RUN" -eq 1 ]; then
    log "dry-run: tar -xpf $archive -C $dest_parent"
  else
    tar -xpf "$archive" -C "$dest_parent"
  fi
}

write_manifest() {
  manifest_path="$1"
  src_abs="$2"
  backup_root_abs="$3"
  version_dir_abs="$4"
  archive_abs="$5"
  hash_tool="$6"

  tmp_manifest="${manifest_path}.tmp.$$"
  {
    printf 'SOURCE_ABS=%s\n' "$src_abs"
    printf 'BACKUP_ROOT_ABS=%s\n' "$backup_root_abs"
    printf 'BACKUP_DIR_ABS=%s\n' "$version_dir_abs"
    printf 'ARCHIVE_ABS=%s\n' "$archive_abs"
    printf 'FILES_BEGIN\n'
  } > "$tmp_manifest"

  tar -tf "$archive_abs" | while IFS= read -r entry; do
    case "$entry" in
      */) continue ;;
    esac
    if [ -d "$src_abs" ]; then
      full_path="$src_abs/$entry"
      rel_path="$entry"
    else
      full_path="$src_abs"
      rel_path="$(basename -- "$src_abs")"
    fi
    if [ -e "$full_path" ]; then
      hash="$(hash_file "$hash_tool" "$full_path")"
      printf '%s\t%s\n' "$hash" "$rel_path" >> "$tmp_manifest"
    fi
  done
  printf 'FILES_END\n' >> "$tmp_manifest"

  mv "$tmp_manifest" "$manifest_path"
}

DRY_RUN=""
ROOT=""
EXCLUDE_PATTERNS=""
DO_LIST=0
DO_REVERT=0
DO_DIFF=0
VERSION_ID=""
TARGET_PATH=""
EXTRA_PATHS=""

while [ $# -gt 0 ]; do
  case "$1" in
    --root)
      shift
      [ $# -gt 0 ] || die "--root requires a path"
      ROOT="$1"
      ;;
    --exclude)
      shift
      [ $# -gt 0 ] || die "--exclude requires a pattern"
      EXCLUDE_PATTERNS="${EXCLUDE_PATTERNS} $1"
      ;;
    --list)
      DO_LIST=1
      ;;
    --revert)
      DO_REVERT=1
      ;;
    --diff)
      DO_DIFF=1
      ;;
    --version)
      shift
      [ $# -gt 0 ] || die "--version requires an id"
      VERSION_ID="$1"
      ;;
    --apply)
      DRY_RUN=0
      ;;
    --dry-run)
      DRY_RUN=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      die "unknown flag: $1"
      ;;
    *)
      if [ -n "$TARGET_PATH" ]; then
        EXTRA_PATHS="${EXTRA_PATHS} $1"
      else
        TARGET_PATH="$1"
      fi
      ;;
  esac
  shift
done

if [ $# -gt 0 ]; then
  if [ -n "$TARGET_PATH" ]; then
    EXTRA_PATHS="${EXTRA_PATHS} $1"
  else
    TARGET_PATH="$1"
  fi
fi

if [ -z "$TARGET_PATH" ] && [ "$DO_LIST" -eq 0 ]; then
  die "path is required"
fi

if [ -n "$VERSION_ID" ] && [ "$DO_REVERT" -eq 0 ]; then
  die "--version requires --revert"
fi

if [ "$DO_LIST" -eq 1 ] && [ "$DO_REVERT" -eq 1 ]; then
  die "--list and --revert are mutually exclusive"
fi

if [ "$DO_DIFF" -eq 1 ] && [ "$DO_LIST" -eq 1 ]; then
  die "--diff and --list are mutually exclusive"
fi

if [ "$DO_DIFF" -eq 1 ] && [ "$DO_REVERT" -eq 1 ]; then
  die "--diff and --revert are mutually exclusive"
fi

if [ -n "$EXTRA_PATHS" ] && [ "$DO_DIFF" -eq 0 ]; then
  die "only --diff supports multiple paths"
fi

if [ -z "$ROOT" ]; then
  ROOT="${HOME}/.bak"
fi
ROOT="$(expand_user_path "$ROOT")"

if [ -z "$DRY_RUN" ]; then
  if [ "$DO_REVERT" -eq 1 ]; then
    DRY_RUN=1
  else
    DRY_RUN=0
  fi
fi

diff_one() {
  target="$1"
  source_abs="$(abs_path_maybe_missing "$target")" || die "unable to resolve path: $target"
  source_parent="$(dirname -- "$source_abs")"
  source_base="$(basename -- "$source_abs")"
  key="$(make_key "$source_parent" "$source_base")" || die "unable to base64-encode path"
  key_dir="${ROOT}/${key}"
  if [ ! -d "$key_dir" ]; then
    die "no backups found for $source_abs"
  fi
  if [ -z "$VERSION_ID" ]; then
    version_id="$(ls -1 "$key_dir" | sort -r | head -n 1)"
  else
    version_id="$VERSION_ID"
  fi
  [ -n "$version_id" ] || die "no backup versions available"
  version_dir="$key_dir/$version_id"
  archive="$version_dir/${key}.tar"
  if [ ! -f "$archive" ]; then
    die "backup archive not found: $archive"
  fi

  tmp_dir="$(mktemp -d -t bak-diff.XXXXXX)"
  trap 'rm -rf "$tmp_dir"' EXIT
  tar -xpf "$archive" -C "$tmp_dir"

  if [ -d "$source_abs" ]; then
    base="$(basename -- "$source_abs")"
    run_diff_dir "$tmp_dir/$base" "$source_abs" || return 1
  else
    base="$(basename -- "$source_abs")"
    run_diff "$tmp_dir/$base" "$source_abs" || return 1
  fi
}

if [ "$DO_DIFF" -eq 1 ]; then
  status=0
  diff_one "$TARGET_PATH" || status=1
  for extra in $EXTRA_PATHS; do
    diff_one "$extra" || status=1
  done
  exit "$status"
fi

# With no target, inventory the stored manifests without resolving source paths.
if [ "$DO_LIST" -eq 1 ] && [ -z "$TARGET_PATH" ]; then
  printf 'VERSION\tFILENAME\tDIRECTORY\n'
  for manifest in "$ROOT"/*/*/manifest.txt; do
    [ -f "$manifest" ] || continue
    source_abs="$(sed -n 's/^SOURCE_ABS=//p' "$manifest" | head -n 1)"
    [ -n "$source_abs" ] || die "source path missing in manifest: $manifest"
    version_dir="${manifest%/manifest.txt}"
    printf '%s\t%s\t%s\n' "${version_dir##*/}" \
      "$(basename -- "$source_abs")" "$(dirname -- "$source_abs")"
  done
  exit 0
fi

SOURCE_ABS="$(abs_path_maybe_missing "$TARGET_PATH")" || die "unable to resolve path: $TARGET_PATH"
SOURCE_PARENT="$(dirname -- "$SOURCE_ABS")"
SOURCE_BASE="$(basename -- "$SOURCE_ABS")"
KEY="$(make_key "$SOURCE_PARENT" "$SOURCE_BASE")" || die "unable to base64-encode path"
KEY_DIR="${ROOT}/${KEY}"

if [ "$DO_LIST" -eq 1 ]; then
  if [ ! -d "$KEY_DIR" ]; then
    die "no backups found for $SOURCE_ABS"
  fi
  ls -1 "$KEY_DIR" | sort -r
  exit 0
fi

if [ "$DO_REVERT" -eq 1 ]; then
  if [ ! -d "$KEY_DIR" ]; then
    die "no backups found for $SOURCE_ABS"
  fi
  if [ -z "$VERSION_ID" ]; then
    VERSION_ID="$(ls -1 "$KEY_DIR" | sort -r | head -n 1)"
  fi
  [ -n "$VERSION_ID" ] || die "no backup versions available"
  VERSION_DIR="$KEY_DIR/$VERSION_ID"
  ARCHIVE="$VERSION_DIR/${KEY}.tar"
  if [ ! -f "$ARCHIVE" ]; then
    die "backup archive not found: $ARCHIVE"
  fi
  DEST_PARENT="$(dirname -- "$SOURCE_ABS")"
  ensure_dir "$DEST_PARENT"
  run_tar_extract "$ARCHIVE" "$DEST_PARENT"
  exit 0
fi

if [ ! -e "$SOURCE_ABS" ]; then
  die "path does not exist: $SOURCE_ABS"
fi
if [ ! -r "$SOURCE_ABS" ]; then
  die "path is not readable: $SOURCE_ABS"
fi

if [ -n "$EXCLUDE_PATTERNS" ] && [ -f "$SOURCE_ABS" ]; then
  if matches_exclude "$SOURCE_ABS"; then
    die "file is excluded by pattern"
  fi
  if matches_exclude "$(basename -- "$SOURCE_ABS")"; then
    die "file is excluded by pattern"
  fi
fi

HASH_TOOL="$(pick_hash_tool)" || die "no sha256 tool found (need shasum or sha256sum)"

ensure_dir "$ROOT"
ensure_dir "$KEY_DIR"

BASE_VERSION="$(date -u +%Y%m%dT%H%M%SZ)"
VERSION_ID="$BASE_VERSION"
if [ -d "$KEY_DIR/$VERSION_ID" ]; then
  i=1
  while [ -d "$KEY_DIR/${BASE_VERSION}-$i" ]; do
    i=$((i + 1))
  done
  VERSION_ID="${BASE_VERSION}-$i"
fi

VERSION_DIR="$KEY_DIR/$VERSION_ID"
ensure_dir "$VERSION_DIR"

ARCHIVE="$VERSION_DIR/${KEY}.tar"
MANIFEST="$VERSION_DIR/manifest.txt"

SRC_PARENT="$(dirname -- "$SOURCE_ABS")"
SRC_BASE="$(basename -- "$SOURCE_ABS")"

run_tar_create "$ARCHIVE" "$SRC_PARENT" "$SRC_BASE"

if [ "$DRY_RUN" -eq 1 ]; then
  log "dry-run: write manifest $MANIFEST"
  exit 0
fi

BACKUP_ROOT_ABS="$(abs_path_maybe_missing "$ROOT")" || die "unable to resolve root: $ROOT"
VERSION_DIR_ABS="$(abs_path_maybe_missing "$VERSION_DIR")" || die "unable to resolve version dir: $VERSION_DIR"
ARCHIVE_ABS="$(abs_path_maybe_missing "$ARCHIVE")" || die "unable to resolve archive: $ARCHIVE"

write_manifest "$MANIFEST" "$SOURCE_ABS" "$BACKUP_ROOT_ABS" "$VERSION_DIR_ABS" "$ARCHIVE_ABS" "$HASH_TOOL"
